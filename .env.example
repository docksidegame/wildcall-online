# Postgres connection string (Neon, Render Postgres, Supabase, Railway...). Leave unset locally to use the built-in database in ./data.
DATABASE_URL=
# Comma-separated usernames that become admins when they sign up or sign in.
ADMIN_USERNAMES=jeremy
# Set in production so cookies are Secure.
NODE_ENV=production
# Optional: set to "disable" if your Postgres doesn't use SSL.
PGSSL=
